generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("CUSTOMER") // CUSTOMER | WELDER | SUPPLIER | ADMIN
  city          String?
  phone         String?
  banned        Boolean  @default(false)
  /// When the user agreed to the Terms. Null for accounts created before sign-up asked.
  termsAcceptedAt DateTime?
  createdAt     DateTime @default(now())

  welderProfile   WelderProfile?
  supplierProfile SupplierProfile?
  jobs          Job[]    @relation("CustomerJobs")
  bids          Bid[]
  reviews       Review[] @relation("ReviewAuthor")
  receivedReviews Review[] @relation("ReviewSubject")
  messagesSent  Message[] @relation("MsgFrom")
  messagesRecv  Message[] @relation("MsgTo")
  products      Product[]
  cart          Cart?
  orders        Order[]
  supplierOrderItems OrderItem[] @relation("SupplierItems")
  posts         Post[]
  mobileSessions MobileSession[]
  reportsFiled  Report[]    @relation("ReportsFiled")
  blocking      UserBlock[] @relation("Blocker")
  blockedBy     UserBlock[] @relation("Blocked")
}

model WelderProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String   @default("")
  skills      String   @default("") // comma-separated: TIG,MIG,Stick,Pipe,Stainless,Aluminum
  certifications String @default("") // AWS, CWB, etc.
  serviceArea String   @default("") // city/region
  hourlyRate  Int?
  yearsExp    Int?
  avatarUrl   String   @default("")
  resumeUrl   String   @default("")
  galleryJson String   @default("[]") // JSON array of image URLs
  languages   String   @default("") // comma-separated language names
  country     String   @default("") // country of residence
  serviceCountries String @default("") // comma-separated countries served
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Job {
  id          String   @id @default(cuid())
  customerId  String
  customer    User     @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  description String
  city        String
  category    String   // mobile | fabrication | repair | structural | other
  budget      Int?
  status      String   @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  acceptedBidId String? @unique
  photosJson  String   @default("[]") // JSON array of image URLs (site photos, from the app's camera)
  createdAt   DateTime @default(now())
  bids        Bid[]
  reviews     Review[]
  messages    Message[]
}

model Bid {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  welderId  String
  welder    User     @relation(fields: [welderId], references: [id], onDelete: Cascade)
  amount    Int
  message   String   @default("")
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())
  @@unique([jobId, welderId])
}

model Review {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromId    String
  from      User     @relation("MsgFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("MsgTo", fields: [toId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

// ============ B2B Marketplace ============

model SupplierProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String  @default("")
  description String   @default("")
  website     String   @default("")
  logoUrl     String   @default("")
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProductCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  sortOrder   Int      @default(0)
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    User     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  slug        String   @unique
  name        String
  brand       String   @default("")
  sku         String   @default("")
  description String   @default("")
  priceCents  Int      // in cents, CAD (the settlement currency)
  stock       Int      @default(0)
  imageUrl    String   @default("")
  specsJson   String   @default("{}") // JSON string for specs
  status      String   @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartItems   CartItem[]
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  @@unique([cartId, productId])
}

model Order {
  id            String   @id @default(cuid())
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status        String   @default("PENDING") // PENDING | PAID | SHIPPED | COMPLETED | CANCELLED
  // How the buyer asked to settle: "contact" (we call them) or "net30"
  // (invoice on 30-day terms). The checkout form has always collected this and
  // it was being dropped on the floor, so a Net 30 request never reached ops.
  paymentMethod String   @default("contact") // contact | net30
  subtotalCents Int
  shippingCents Int      @default(0)
  taxCents      Int      @default(0)
  totalCents    Int
  shipName      String
  shipCompany   String   @default("")
  shipAddress   String
  shipCity      String
  shipRegion    String   @default("")
  shipPostal    String   @default("")
  shipCountry   String   @default("US")
  shipPhone     String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  items         OrderItem[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  supplierId   String
  supplier     User     @relation("SupplierItems", fields: [supplierId], references: [id])
  nameSnapshot String
  priceCents   Int
  quantity     Int
  status       String   @default("PENDING") // PENDING | FULFILLED | CANCELLED
}

// ============ Blog ============

model PostCategory {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String         @default("")
  parentId    String?
  parent      PostCategory?  @relation("PostCategoryTree", fields: [parentId], references: [id])
  children    PostCategory[] @relation("PostCategoryTree")
  sortOrder   Int            @default(0)
  posts       Post[]
  createdAt   DateTime       @default(now())
}

model PostTag {
  id    String         @id @default(cuid())
  slug  String         @unique
  name  String
  posts PostToTag[]
}

model Post {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  excerpt       String      @default("")
  body          String      @default("")   // HTML / markdown content
  coverImage    String      @default("")   // main hero image URL
  seoTitle      String      @default("")
  seoDesc       String      @default("")
  seoKeywords   String      @default("")   // comma-separated
  status        String      @default("DRAFT") // DRAFT | PUBLISHED
  views         Int         @default(0)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  categoryId    String
  category      PostCategory @relation(fields: [categoryId], references: [id])
  tags          PostToTag[]
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PostToTag {
  postId String
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([postId, tagId])
}

// extend User with blog posts
// (relation added inline above via authorId)

// ============ Project Management ============

model ProjectBoard {
  id          String        @id @default(cuid())
  title       String
  description String        @default("")
  color       String        @default("#ef4444") // hex accent color
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  tasks       ProjectTask[]
}

model ProjectTask {
  id          String       @id @default(cuid())
  boardId     String
  board       ProjectBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  description String       @default("")
  assignee    String       @default("") // name of team member
  status      String       @default("TODO") // TODO | IN_PROGRESS | DONE | BLOCKED
  priority    String       @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  tags        String       @default("") // comma-separated
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ============ Mobile app ============

// One row per signed-in device. The refresh token is stored only as a SHA-256
// hash, rotated on every use, and revoked on sign-out, so a lost phone can be
// cut off without touching the user's web session. The device's Expo push
// token lives here too: it belongs to the install, not to the user.
model MobileSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  deviceName  String    @default("")
  platform    String    @default("") // ios | android
  pushToken   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  @@index([pushToken])
}

// A user flagging content or another user (App Store guideline 1.2, Play's
// user-generated content policy). Ops is emailed on each new report.
model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   String   // JOB | BID | REVIEW | MESSAGE | USER | PRODUCT
  targetId     String
  targetUserId String?  // whose content it is, resolved on the server
  reason       String   // SPAM | HARASSMENT | INAPPROPRIATE | SCAM | OTHER
  details      String   @default("")
  status       String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@index([targetUserId])
}

// One user hiding another. Applies both ways: neither sees the other's jobs,
// bids, reviews, profile or products, and neither can message the other.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
