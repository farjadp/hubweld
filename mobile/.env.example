# Origin of the HubWeld site/API, no trailing slash. Inlined at build time.
#   Production:        https://hubweld.ca
#   iOS simulator:     http://localhost:3000
#   Android emulator:  http://10.0.2.2:3000
# Leave unset in development to use the machine running Metro on port 3000,
# which also works from a physical phone on the same Wi-Fi.
# EXPO_PUBLIC_API_URL="https://hubweld.ca"
