# Local dev uses SQLite by default. For production, switch to Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/hubweld?schema=public"
DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI — required for AI blog generation
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Cron secret — must match the ?secret= query param in GitHub Actions workflow
CRON_SECRET="change-me-to-a-random-secret"

# Where uploaded files (welder avatars, resumes, project gallery) are stored.
# Leave empty in dev (defaults to ./public/uploads, served statically).
# On Railway, point this to the persistent volume so uploads survive redeploys:
# UPLOAD_DIR="/app/data/uploads"
UPLOAD_DIR=""

# ── Email (Resend HTTP API — Railway blocks outbound SMTP) ──────────────
# Without RESEND_API_KEY the app still works: messages are logged instead of
# sent and checkout never fails. Set all three to actually deliver.
RESEND_API_KEY="re_..."
# Must be a domain verified in Resend, e.g. "HubWeld <orders@hubweld.ca>"
EMAIL_FROM="HubWeld <orders@hubweld.ca>"
# Where the "call this buyer to arrange payment" alert goes. If this is unset
# nobody is told an order came in, and the promise made at checkout is broken.
OPS_EMAIL="orders@hubweld.ca"

# ── Canonical site origin (defaults to https://hubweld.ca) ─────────────
# NEXT_PUBLIC_SITE_URL="https://hubweld.ca"

# ── FX display rates, override without a deploy ────────────────────────
# FX_RATE_USD="0.7266"
# FX_RATE_EUR="0.6217"
