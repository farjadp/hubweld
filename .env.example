# Local dev uses SQLite by default. For production, switch to Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/hubweld?schema=public"
DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI — required for AI blog generation
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Cron secret — sent by the GitHub Action as `Authorization: Bearer <secret>`.
# (The old ?secret= query form still works for one release. Rotate this value
# when you drop it: anything that travelled in a URL is in an access log.)
CRON_SECRET="change-me-to-a-random-secret"

# Where uploaded files (welder avatars, resumes, project gallery) are stored.
# Leave empty in dev (defaults to ./public/uploads, served statically).
# On Railway, point this to the persistent volume so uploads survive redeploys:
# UPLOAD_DIR="/app/data/uploads"
UPLOAD_DIR=""

# ── Email (Resend HTTP API — Railway blocks outbound SMTP) ──────────────
# Without RESEND_API_KEY the app still works: messages are logged instead of
# sent and checkout never fails. Set all three to actually deliver.
RESEND_API_KEY="re_..."
# Must be a domain verified in Resend, e.g. "HubWeld <orders@hubweld.ca>"
EMAIL_FROM="HubWeld <orders@hubweld.ca>"
# Where the "call this buyer to arrange payment" alert goes. If this is unset
# nobody is told an order came in, and the promise made at checkout is broken.
OPS_EMAIL="orders@hubweld.ca"

# ── Canonical site origin (defaults to https://hubweld.ca) ─────────────
# NEXT_PUBLIC_SITE_URL="https://hubweld.ca"

# ── Mobile app store listings (read per request, no rebuild needed) ───
# Unset = that store button shows "Coming soon" on /app and the homepage.
# APP_STORE_URL="https://apps.apple.com/app/id..."
# PLAY_STORE_URL="https://play.google.com/store/apps/details?id=ca.hubweld.app"
# Direct download for phones without Google Play (Play-signed universal APK).
# ANDROID_APK_URL="https://github.com/farjadp/hubweld/releases/download/android-1.0.0-3/hubweld-1.0.0.apk"

# ── FX display rates, override without a deploy ────────────────────────
# Prices settle in CAD; these only drive the indicative USD/EUR display.
# Read server-side, so a change takes effect on the next request.
# FX_RATE_USD="0.7266"
# FX_RATE_EUR="0.6217"

# ── Mobile app (mobile/) ────────────────────────────────────────────────
# Signs the app's 15-minute access tokens. Falls back to NEXTAUTH_SECRET when
# unset; set a separate value so rotating one does not sign out the other.
# MOBILE_JWT_SECRET="another-long-random-string"
# Only needed if "enhanced push security" is enabled on the Expo project.
# EXPO_ACCESS_TOKEN=""
